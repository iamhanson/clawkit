{
  "name": "hotnews-kit",
  "version": "2.0.0",
  "displayName": "Hot News Harness Workflow",
  "description": "Harness-style workflow for research, multi-platform writing, evaluation, and revision",
  "agents": [
    { "id": "orchestrator", "role": "Workflow Orchestrator", "soulFile": "agents/orchestrator/SOUL.md", "allowAgents": ["researcher", "toutiao-writer", "xhs-writer", "wechat-writer", "douyin-writer", "editor"], "tools": { "profile": "full" } },
    { "id": "researcher", "role": "News Researcher", "soulFile": "agents/researcher/SOUL.md", "allowAgents": ["orchestrator"], "tools": { "profile": "full" } },
    { "id": "toutiao-writer", "role": "Toutiao Writer", "soulFile": "agents/toutiao-writer/SOUL.md", "allowAgents": ["orchestrator"], "tools": { "profile": "full" } },
    { "id": "xhs-writer", "role": "Xiaohongshu Writer", "soulFile": "agents/xhs-writer/SOUL.md", "allowAgents": ["orchestrator"], "tools": { "profile": "full" } },
    { "id": "wechat-writer", "role": "WeChat Writer", "soulFile": "agents/wechat-writer/SOUL.md", "allowAgents": ["orchestrator"], "tools": { "profile": "full" } },
    { "id": "douyin-writer", "role": "Douyin Script Writer", "soulFile": "agents/douyin-writer/SOUL.md", "allowAgents": ["orchestrator"], "tools": { "profile": "full" } },
    { "id": "editor", "role": "Content Editor", "soulFile": "agents/editor/SOUL.md", "allowAgents": ["orchestrator"], "tools": { "profile": "full" } }
  ],
  "sharedWorkspace": "workspace-shared",
  "setup": "setup.js"
}
