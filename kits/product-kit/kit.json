{
  "name": "product-kit",
  "version": "1.0.0",
  "displayName": "Product Development Workflow",
  "description": "PM -> Dev -> QA product delivery workflow with strict routing and shared workspace",
  "agents": [
    {
      "id": "pm",
      "role": "Product Manager",
      "soulFile": "agents/pm/SOUL.md",
      "allowAgents": ["dev"]
    },
    {
      "id": "dev",
      "role": "Developer",
      "soulFile": "agents/dev/SOUL.md",
      "allowAgents": ["pm", "qa"]
    },
    {
      "id": "qa",
      "role": "QA Tester",
      "soulFile": "agents/qa/SOUL.md",
      "allowAgents": ["dev", "pm"]
    }
  ],
  "sharedWorkspace": "workspace-shared"
}
