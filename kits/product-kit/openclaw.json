{
  "agents": {
    "defaults": {
      "workspace": "examples/product-cycle/workspace-shared"
    },
    "list": [
      {
        "id": "pm",
        "workspace": "examples/product-cycle/workspace-pm",
        "subagents": {
          "allowAgents": ["dev"]
        }
      },
      {
        "id": "dev",
        "workspace": "examples/product-cycle/workspace-dev",
        "subagents": {
          "allowAgents": ["pm", "qa"]
        }
      },
      {
        "id": "qa",
        "workspace": "examples/product-cycle/workspace-qa",
        "subagents": {
          "allowAgents": ["dev", "pm"]
        }
      }
    ]
  }
}
